        "title": "M01 · Ending",
        "properties": {
          "title": "M01 · Ending",
          "location": "House",
          "charactersPresent": "",
          "text": "Father: I'm so proud of you for doing the most basic thing imaginable, it took you long enough, I wish I could say I was proud of you but the truth is I'm embarrassed and just a little horrified that you emerged from my loins.\nFather: The thing in the mailbox was your fancy flashlight. You can click the mouse to send a ping into the world, no matter how dark it is, but remember that when you do so, they can see you, and they might get you.\nFather: Now that the sky has become so dark, and the storm is coming, I'm going to need some things to get my machine working. Go ask Mr. Miller at the general store for some transducers.\nFather: And for fekk shake - don't fall asleep again, you never know what can happen.",
          "audioLoop": "",
          "audioLoopName": "",
          "audioOneShot": "",
          "audioOneShotName": "",
          "background": "",
          "backgroundName": "",
          "showCharacterImages": true,
          "rewardItems": "",
          "rewardKnowledge": "",
          "startMission": "",
          "completeMission": "Get the Package",
          "isChapterStart": false
        }
      },
