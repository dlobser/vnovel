        ],
        "title": "M02 · Intro",
        "properties": {
          "title": "M02 · Intro",
          "location": "House",
          "charactersPresent": "",
          "text": "Father: One more thing about that flashlight. It doesn't run on batteries, it runs on you. The longer you're out there with it, the more it takes out of you.\nFather: And when you get tired, the Night Crusher comes. It follows you, but it won't move while you're looking at it. While you're fresh, that's all it does.\nFather: When you're dead on your feet, looking at it is the last thing you'll ever do. Eat berries when you find them. They'll keep you going.\nFather: Now. Tonight we're having a nice dinner. As a family. Like we used to.\nFather: Your mother and your sister aren't here yet, so the effigies will have to sit in for them, and they aren't finished.\nFather: I need a dress, some string and a button. Don't come back without all three.",
          "audioLoop": "",
          "audioLoopName": "",
          "audioOneShot": "",
          "audioOneShotName": "",
          "background": "",
          "backgroundName": "",
          "showCharacterImages": true,
          "rewardItems": "",
          "rewardKnowledge": "",
          "startMission": "The Effigies",
          "completeMission": "",
          "isChapterStart": false
        }
      },
